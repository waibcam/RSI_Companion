{
  "name": "@rsi-companion/extension",
  "version": "3.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "RSI Companion browser extension (Chrome/Edge/Firefox) — v3",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "pnpm compile",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@rsi-companion/shared": "workspace:*",
    "lucide-svelte": "^0.456.0",
    "svelte": "^5.1.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0-beta.4",
    "@types/chrome": "^0.0.280",
    "@types/firefox-webext-browser": "^120.0.4",
    "@wxt-dev/module-svelte": "^2.0.2",
    "svelte-check": "^4.0.6",
    "tailwindcss": "^4.0.0-beta.4",
    "typescript": "^5.6.3",
    "wxt": "^0.19.13"
  }
}
