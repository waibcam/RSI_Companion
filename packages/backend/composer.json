{
  "name": "rsi-companion/backend",
  "description": "RSI Companion backend API — v3",
  "type": "project",
  "license": "GPL-3.0-only",
  "require": {
    "php": "^7.4 || ^8.0",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "php-di/php-di": "^7.0",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^2.9",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "RsiCompanion\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RsiCompanion\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "start": "php -S 127.0.0.1:8080 -t public public/index.php",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
