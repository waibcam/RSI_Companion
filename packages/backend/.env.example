APP_ENV=development
LOG_LEVEL=debug

# SQLite database path (absolute or relative to packages/backend/)
DB_PATH=./data/app.sqlite

# Comma-separated list of explicit origins allowed by CORS (in addition to the
# extension-origin regex). Example: https://localhost:5173
CORS_ALLOWED_ORIGINS=

# Rate limit per IP/bucket (requests per minute)
RATE_LIMIT_RPM=60
